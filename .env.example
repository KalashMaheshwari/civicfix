# CivicFix Environment Configuration

# Supabase API Settings (Found in Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Storage Bucket
SUPABASE_STORAGE_BUCKET=civic-issues

# AI & Detection Settings
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
CONFIDENCE_THRESHOLD=0.70
MARGIN_THRESHOLD=0.15
SIMILARITY_THRESHOLD=0.88

# Geospatial Deduplication Distance (in meters)
GEO_MATCH_RADIUS_METERS=50.0

# API Settings
API_V1_STR=/api/v1
PROJECT_NAME="CivicFix Backend"
